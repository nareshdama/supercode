{
  "name": "supercode",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supercode": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@supercode/core": "0.1.0",
    "@supercode/detect": "0.1.0",
    "@supercode/mcp": "0.1.0",
    "@supercode/models": "0.1.0",
    "@supercode/permissions": "0.1.0",
    "@supercode/progress": "0.1.0",
    "@supercode/state": "0.1.0",
    "@supercode/tasks": "0.1.0",
    "@supercode/tools": "0.1.0",
    "@supercode/workflows": "0.1.0"
  }
}
