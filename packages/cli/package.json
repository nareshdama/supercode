      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nareshdama/core": "0.1.0",
    "@nareshdama/detect": "0.1.0",
    "@nareshdama/memory": "0.1.0",
    "@nareshdama/mcp": "0.1.0",
    "@nareshdama/models": "0.1.0",
    "@nareshdama/permissions": "0.1.0",
    "@nareshdama/progress": "0.1.0",
    "@nareshdama/state": "0.1.0",
    "@nareshdama/tasks": "0.1.0",
    "@nareshdama/tools": "0.1.0",
    "@nareshdama/workflows": "0.1.0"
  }
}
